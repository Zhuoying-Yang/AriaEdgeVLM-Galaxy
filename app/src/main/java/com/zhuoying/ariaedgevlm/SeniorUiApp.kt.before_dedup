package com.zhuoying.ariaedgevlm

import androidx.activity.compose.BackHandler
import androidx.compose.foundation.BorderStroke
import androidx.compose.foundation.Image
import androidx.compose.foundation.background
import androidx.compose.foundation.border
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.res.painterResource
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextAlign
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

private val SeniorBlue = Color(0xFF2854C7)
private val SeniorLightBlue = Color(0xFFF0F4FF)
private val SeniorCard = Color(0xFFF8F9FB)
private val SeniorBorder = Color(0xFFE8EAF0)
private val SeniorSecondary = Color(0xFF697386)
private val SeniorGreen = Color(0xFF22A447)

private enum class SeniorScreen {
    DASHBOARD,
    IMPORTANT_PEOPLE,
    ADD_PERSON,
    JEMMA_DETAIL,
    SARAH_DETAIL,
    FAMILY_MEMORY,
    GROCERY_LIST,
    MEMORY_ALERT,
    SAVED_MEMORY,
    RECOGNITION
}

@Composable
fun SeniorUiApp(
    onOpenSettings: () -> Unit = {}
) {
    var screen by remember {
        mutableStateOf(
            SeniorScreen.DASHBOARD
        )
    }

    var recognitionName by remember {
        mutableStateOf("Jemma")
    }

    var recognitionRelationship by remember {
        mutableStateOf("Your wife")
    }

    var recognitionReturnScreen by remember {
        mutableStateOf(
            SeniorScreen.JEMMA_DETAIL
        )
    }

    var groceryReturnScreen by remember {
        mutableStateOf(
            SeniorScreen.DASHBOARD
        )
    }

    var alertReturnScreen by remember {
        mutableStateOf(
            SeniorScreen.DASHBOARD
        )
    }

    val groceryItems = remember {
        mutableStateListOf(
            "Eggs",
            "Sourdough bread",
            "Strawberries",
            "Oat milk",
            "Spinach"
        )
    }

    val groceryMemoryItems = remember {
        mutableStateListOf<String>()
    }

    val groceryChecked = remember {
        mutableStateMapOf<String, Boolean>()
    }

    fun go(
        destination: SeniorScreen
    ) {
        screen = destination
    }

    BackHandler(
        enabled =
            screen != SeniorScreen.DASHBOARD
    ) {
        screen = when (screen) {

            SeniorScreen.IMPORTANT_PEOPLE ->
                SeniorScreen.DASHBOARD

            SeniorScreen.ADD_PERSON ->
                SeniorScreen.IMPORTANT_PEOPLE

            SeniorScreen.JEMMA_DETAIL,
            SeniorScreen.SARAH_DETAIL,
            SeniorScreen.FAMILY_MEMORY ->
                SeniorScreen.IMPORTANT_PEOPLE

            SeniorScreen.GROCERY_LIST ->
                groceryReturnScreen

            SeniorScreen.MEMORY_ALERT ->
                alertReturnScreen

            SeniorScreen.SAVED_MEMORY ->
                SeniorScreen.MEMORY_ALERT

            SeniorScreen.RECOGNITION ->
                recognitionReturnScreen

            SeniorScreen.DASHBOARD ->
                SeniorScreen.DASHBOARD
        }
    }

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = Color.White
    ) {
        when (screen) {

            SeniorScreen.DASHBOARD -> {
                SeniorDashboardScreen(
                    onPeople = {
                        go(
                            SeniorScreen
                                .IMPORTANT_PEOPLE
                        )
                    },
                    onGrocery = {
                        groceryReturnScreen =
                            SeniorScreen.DASHBOARD

                        go(
                            SeniorScreen
                                .GROCERY_LIST
                        )
                    },
                    onAlert = {
                        alertReturnScreen =
                            SeniorScreen.DASHBOARD

                        go(
                            SeniorScreen
                                .MEMORY_ALERT
                        )
                    },
                    onSettings =
                        onOpenSettings
                )
            }

            SeniorScreen.IMPORTANT_PEOPLE -> {
                ImportantPeopleScreen(
                    onBack = {
                        go(
                            SeniorScreen
                                .DASHBOARD
                        )
                    },
                    onAdd = {
                        go(
                            SeniorScreen
                                .ADD_PERSON
                        )
                    },
                    onJemma = {
                        go(
                            SeniorScreen
                                .JEMMA_DETAIL
                        )
                    },
                    onSarah = {
                        go(
                            SeniorScreen
                                .SARAH_DETAIL
                        )
                    },
                    onElliot = {
                        go(
                            SeniorScreen
                                .FAMILY_MEMORY
                        )
                    },
                    onMemoryAlert = {
                        alertReturnScreen =
                            SeniorScreen
                                .IMPORTANT_PEOPLE

                        go(
                            SeniorScreen
                                .MEMORY_ALERT
                        )
                    }
                )
            }

            SeniorScreen.ADD_PERSON -> {
                AddPersonDemoScreen(
                    onBack = {
                        go(
                            SeniorScreen
                                .IMPORTANT_PEOPLE
                        )
                    },
                    onSave = {
                        go(
                            SeniorScreen
                                .JEMMA_DETAIL
                        )
                    }
                )
            }

            SeniorScreen.JEMMA_DETAIL -> {
                SeniorPersonDetailScreen(
                    name = "Jemma",
                    relationship = "Your wife",
                    note =
                        "Lives with you in Boston.",
                    imageRes =
                        R.drawable.jemma,
                    initials = null,
                    onBack = {
                        go(
                            SeniorScreen
                                .IMPORTANT_PEOPLE
                        )
                    },
                    onRecognition = {
                        recognitionName =
                            "Jemma"

                        recognitionRelationship =
                            "Your wife"

                        recognitionReturnScreen =
                            SeniorScreen
                                .JEMMA_DETAIL

                        go(
                            SeniorScreen
                                .RECOGNITION
                        )
                    }
                )
            }

            SeniorScreen.SARAH_DETAIL -> {
                SeniorPersonDetailScreen(
                    name = "Sarah",
                    relationship =
                        "Your daughter",
                    note =
                        "Works as a nurse at Mass General.",
                    imageRes = null,
                    initials = "SA",
                    onBack = {
                        go(
                            SeniorScreen
                                .IMPORTANT_PEOPLE
                        )
                    },
                    onRecognition = {
                        recognitionName =
                            "Sarah"

                        recognitionRelationship =
                            "Your daughter"

                        recognitionReturnScreen =
                            SeniorScreen
                                .SARAH_DETAIL

                        go(
                            SeniorScreen
                                .RECOGNITION
                        )
                    }
                )
            }

            SeniorScreen.FAMILY_MEMORY -> {
                FamilyMemoryDemoScreen(
                    onBack = {
                        go(
                            SeniorScreen
                                .IMPORTANT_PEOPLE
                        )
                    },
                    onShoppingList = {
                        val memoryItems =
                            listOf(
                                "Cinnamon raisin bagels",
                                "Plain cream cheese"
                            )

                        memoryItems.forEach {
                            item ->

                            if (
                                item !in groceryItems
                            ) {
                                groceryItems.add(
                                    item
                                )
                            }

                            if (
                                item !in
                                groceryMemoryItems
                            ) {
                                groceryMemoryItems
                                    .add(item)
                            }

                            groceryChecked
                                .putIfAbsent(
                                    item,
                                    false
                                )
                        }

                        groceryReturnScreen =
                            SeniorScreen
                                .FAMILY_MEMORY

                        go(
                            SeniorScreen
                                .GROCERY_LIST
                        )
                    }
                )
            }

            SeniorScreen.GROCERY_LIST -> {
                GroceryListDemoScreen(
                    items = groceryItems,
                    memoryItems =
                        groceryMemoryItems,
                    checked =
                        groceryChecked,
                    onBack = {
                        go(
                            groceryReturnScreen
                        )
                    },
                    onReminder = {
                        alertReturnScreen =
                            SeniorScreen
                                .GROCERY_LIST

                        go(
                            SeniorScreen
                                .MEMORY_ALERT
                        )
                    }
                )
            }

            SeniorScreen.MEMORY_ALERT -> {
                MemoryAlertDemoScreen(
                    onDismiss = {
                        go(
                            alertReturnScreen
                        )
                    },
                    onView = {
                        go(
                            SeniorScreen
                                .SAVED_MEMORY
                        )
                    }
                )
            }

            SeniorScreen.SAVED_MEMORY -> {
                SavedMemoryDemoScreen(
                    onBack = {
                        go(
                            SeniorScreen
                                .MEMORY_ALERT
                        )
                    },
                    onHome = {
                        go(
                            SeniorScreen
                                .DASHBOARD
                        )
                    }
                )
            }

            SeniorScreen.RECOGNITION -> {
                RecognitionDemoScreen(
                    name =
                        recognitionName,
                    relationship =
                        recognitionRelationship,
                    onBack = {
                        go(
                            recognitionReturnScreen
                        )
                    }
                )
            }
        }
    }
}

@Composable
private fun SeniorHeader(
    title: String,
    onBack: (() -> Unit)? = null
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(
                horizontal = 20.dp,
                vertical = 18.dp
            ),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier.width(48.dp)
        ) {
            if (onBack != null) {
                Text(
                    text = "‹",
                    fontSize = 38.sp,
                    modifier = Modifier.clickable {
                        onBack()
                    }
                )
            }
        }

        Text(
            text = title,
            fontSize = 19.sp,
            fontWeight = FontWeight.Bold,
            textAlign = TextAlign.Center,
            modifier = Modifier.weight(1f)
        )

        Spacer(
            modifier = Modifier.width(48.dp)
        )
    }
}

@Composable
private fun SeniorPrimaryButton(
    text: String,
    onClick: () -> Unit
) {
    Button(
        onClick = onClick,
        modifier = Modifier
            .fillMaxWidth()
            .height(56.dp),
        shape = RoundedCornerShape(16.dp),
        colors = ButtonDefaults.buttonColors(
            containerColor = SeniorBlue
        )
    ) {
        Text(
            text = text,
            fontSize = 16.sp,
            fontWeight = FontWeight.Bold
        )
    }
}

@Composable
private fun SeniorSecondaryButton(
    text: String,
    onClick: () -> Unit
) {
    OutlinedButton(
        onClick = onClick,
        modifier = Modifier
            .fillMaxWidth()
            .height(52.dp),
        shape = RoundedCornerShape(16.dp),
        border = BorderStroke(
            1.dp,
            SeniorBorder
        )
    ) {
        Text(
            text = text,
            color = SeniorBlue,
            fontWeight = FontWeight.SemiBold
        )
    }
}

@Composable
private fun SeniorAvatar(
    imageRes: Int? = null,
    initials: String? = null,
    size: Int = 58
) {
    Box(
        modifier = Modifier
            .size(size.dp)
            .clip(CircleShape)
            .background(SeniorBlue),
        contentAlignment = Alignment.Center
    ) {
        if (imageRes != null) {
            Image(
                painter = painterResource(imageRes),
                contentDescription = null,
                contentScale = ContentScale.Crop,
                modifier = Modifier.fillMaxSize()
            )
        } else {
            Text(
                text = initials ?: "",
                color = Color.White,
                fontSize = 18.sp,
                fontWeight = FontWeight.Bold
            )
        }
    }
}

@Composable
private fun PersonCard(
    name: String,
    relationship: String,
    imageRes: Int? = null,
    initials: String? = null,
    onClick: () -> Unit
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(18.dp))
            .background(SeniorCard)
            .border(
                1.dp,
                SeniorBorder,
                RoundedCornerShape(18.dp)
            )
            .clickable {
                onClick()
            }
            .padding(16.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        SeniorAvatar(
            imageRes = imageRes,
            initials = initials
        )

        Spacer(
            modifier = Modifier.width(14.dp)
        )

        Column(
            modifier = Modifier.weight(1f)
        ) {
            Text(
                text = name,
                fontSize = 18.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                text = relationship,
                color = SeniorSecondary,
                fontSize = 14.sp
            )
        }

        Text(
            text = "›",
            color = SeniorSecondary,
            fontSize = 30.sp
        )
    }
}

@Composable
private fun SeniorDashboardScreen(
    onPeople: () -> Unit,
    onGrocery: () -> Unit,
    onAlert: () -> Unit,
    onSettings: () -> Unit
) {
    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(
                rememberScrollState()
            )
            .padding(20.dp)
    ) {
        Spacer(
            modifier = Modifier.height(10.dp)
        )

        Text(
            text = "AI Glasses Companion",
            fontSize = 27.sp,
            fontWeight = FontWeight.Bold
        )

        Spacer(
            modifier = Modifier.height(5.dp)
        )

        Text(
            text =
                "Manage what your glasses remember " +
                "and how they help you.",
            color = SeniorSecondary,
            fontSize = 15.sp,
            lineHeight = 21.sp
        )

        Spacer(
            modifier = Modifier.height(22.dp)
        )

        SeniorSystemCard()

        Spacer(
            modifier = Modifier.height(24.dp)
        )

        Text(
            text = "How it works",
            fontSize = 18.sp,
            fontWeight = FontWeight.Bold
        )

        Spacer(
            modifier = Modifier.height(10.dp)
        )

        Surface(
            modifier =
                Modifier.fillMaxWidth(),
            shape =
                RoundedCornerShape(18.dp),
            color = SeniorLightBlue
        ) {
            Column(
                modifier =
                    Modifier.padding(18.dp)
            ) {
                HowItWorksRow(
                    number = "1",
                    title =
                        "Your glasses notice context",
                    detail =
                        "A person, place, or situation."
                )

                Spacer(
                    modifier =
                        Modifier.height(14.dp)
                )

                HowItWorksRow(
                    number = "2",
                    title =
                        "A relevant memory appears",
                    detail =
                        "Only when it may be useful."
                )

                Spacer(
                    modifier =
                        Modifier.height(14.dp)
                )

                HowItWorksRow(
                    number = "3",
                    title =
                        "You choose what to do",
                    detail =
                        "Remember it, shop, navigate, or dismiss."
                )
            }
        }

        Spacer(
            modifier = Modifier.height(26.dp)
        )

        Text(
            text = "Manage",
            fontSize = 18.sp,
            fontWeight = FontWeight.Bold
        )

        Spacer(
            modifier = Modifier.height(10.dp)
        )

        DashboardFeatureCard(
            title = "People & Memories",
            description =
                "Add important people and review memories connected to them.",
            action = "Open",
            onClick = onPeople
        )

        Spacer(
            modifier = Modifier.height(12.dp)
        )

        DashboardFeatureCard(
            title = "Grocery List",
            description =
                "View your shopping list and items suggested from memories.",
            action = "View list",
            onClick = onGrocery
        )

        Spacer(
            modifier = Modifier.height(12.dp)
        )

        DashboardFeatureCard(
            title = "Recent Memory Alert",
            description =
                "Preview how a useful memory can appear on your glasses.",
            action = "Preview",
            onClick = onAlert
        )

        Spacer(
            modifier = Modifier.height(12.dp)
        )

        DashboardFeatureCard(
            title = "Settings",
            description =
                "Adjust text size, display preferences, and setup options.",
            action = "Open",
            onClick = onSettings
        )

        Spacer(
            modifier = Modifier.height(26.dp)
        )

        Surface(
            modifier =
                Modifier.fillMaxWidth(),
            shape =
                RoundedCornerShape(16.dp),
            border =
                BorderStroke(
                    1.dp,
                    SeniorBorder
                ),
            color = Color.White
        ) {
            Column(
                modifier =
                    Modifier.padding(16.dp)
            ) {
                Text(
                    text = "Glasses Preview",
                    fontWeight =
                        FontWeight.Bold,
                    color = SeniorBlue
                )

                Spacer(
                    modifier =
                        Modifier.height(5.dp)
                )

                Text(
                    text =
                        "Recognition and memory alerts shown later are previews of what the wearer would see on the glasses. They are separate from the phone controls.",
                    color =
                        SeniorSecondary,
                    fontSize = 13.sp,
                    lineHeight = 19.sp
                )
            }
        }

        Spacer(
            modifier = Modifier.height(30.dp)
        )
    }
}


@Composable
private fun SeniorSystemCard() {
    Surface(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(18.dp),
        border = BorderStroke(
            1.dp,
            SeniorBorder
        ),
        color = SeniorCard
    ) {
        Column(
            modifier = Modifier.padding(18.dp)
        ) {
            Text(
                text = "System Status",
                fontWeight = FontWeight.Bold,
                fontSize = 17.sp
            )

            Spacer(
                modifier = Modifier.height(15.dp)
            )

            SeniorSystemStatusRow(
                label = "Aria Glasses",
                value = "Connected"
            )

            Spacer(
                modifier = Modifier.height(11.dp)
            )

            SeniorSystemStatusRow(
                label = "On-device AI",
                value = "Gemma E4B"
            )

            Spacer(
                modifier = Modifier.height(11.dp)
            )

            SeniorSystemStatusRow(
                label = "Long-term Memory",
                value = "Active"
            )
        }
    }
}


@Composable
private fun SeniorSystemStatusRow(
    label: String,
    value: String
) {
    Row(
        modifier = Modifier.fillMaxWidth(),
        verticalAlignment =
            Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier
                .size(9.dp)
                .clip(CircleShape)
                .background(SeniorGreen)
        )

        Spacer(
            modifier = Modifier.width(10.dp)
        )

        Text(
            text = label,
            modifier = Modifier.weight(1f),
            fontSize = 14.sp
        )

        Text(
            text = value,
            color = SeniorSecondary,
            fontWeight = FontWeight.Medium,
            fontSize = 14.sp
        )
    }
}


@Composable
private fun HowItWorksRow(
    number: String,
    title: String,
    detail: String
) {
    Row(
        verticalAlignment =
            Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier
                .size(34.dp)
                .clip(CircleShape)
                .background(SeniorBlue),
            contentAlignment =
                Alignment.Center
        ) {
            Text(
                text = number,
                color = Color.White,
                fontWeight =
                    FontWeight.Bold
            )
        }

        Spacer(
            modifier = Modifier.width(12.dp)
        )

        Column {
            Text(
                text = title,
                fontWeight =
                    FontWeight.Bold,
                fontSize = 14.sp
            )

            Text(
                text = detail,
                color = SeniorSecondary,
                fontSize = 12.sp
            )
        }
    }
}


@Composable
private fun DashboardFeatureCard(
    title: String,
    description: String,
    action: String,
    onClick: () -> Unit
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clip(
                RoundedCornerShape(18.dp)
            )
            .background(Color.White)
            .border(
                1.dp,
                SeniorBorder,
                RoundedCornerShape(18.dp)
            )
            .clickable {
                onClick()
            }
            .padding(17.dp),
        verticalAlignment =
            Alignment.CenterVertically
    ) {
        Column(
            modifier = Modifier.weight(1f)
        ) {
            Text(
                text = title,
                fontSize = 17.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(4.dp)
            )

            Text(
                text = description,
                color = SeniorSecondary,
                fontSize = 13.sp,
                lineHeight = 18.sp
            )
        }

        Spacer(
            modifier = Modifier.width(12.dp)
        )

        Column(
            horizontalAlignment =
                Alignment.End
        ) {
            Text(
                text = action,
                color = SeniorBlue,
                fontSize = 12.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Text(
                text = "›",
                color = SeniorBlue,
                fontSize = 28.sp
            )
        }
    }
}

