            )

            Spacer(
                modifier = Modifier.height(24.dp)
            )

            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .clip(RoundedCornerShape(20.dp))
                    .background(SeniorLightBlue)
                    .padding(20.dp)
            ) {
                Column {
                    Text(
                        text = "SAVED MEMORY",
                        color = SeniorBlue,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold
                    )

                    Spacer(
                        modifier = Modifier.height(8.dp)
                    )

                    Text(
                        text =
                            "Jemma loved the necklace " +
                            "in this store.",
                        fontSize = 22.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Spacer(
                modifier = Modifier.height(24.dp)
            )

            SeniorPrimaryButton(
                text = if (routed) {
                    "Route Started ✓"
                } else {
                    "Route Me to the Store"
                },
                onClick = {
                    routed = true
                }
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            SeniorSecondaryButton(
                text = "Back to Home",
                onClick = onHome
            )
        }
    }
}

@Composable
private fun RecognitionDemoScreen(
    name: String,
    relationship: String,
    onBack: () -> Unit
) {
    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Color(0xFF33363D)
            ),
        contentAlignment =
            Alignment.Center
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(24.dp)
                .clip(
                    RoundedCornerShape(
                        24.dp
                    )
                )
                .background(
                    Color.White.copy(
                        alpha = 0.12f
                    )
                )
                .padding(30.dp),
            horizontalAlignment =
                Alignment.CenterHorizontally
        ) {
            Text(
                text =
                    "GLASSES PREVIEW",
                color =
                    Color.White.copy(
                        alpha = 0.65f
                    ),
                fontSize = 12.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Spacer(
                modifier =
                    Modifier.height(8.dp)
            )

            Text(
                text =
                    "Person recognized",
                color =
                    Color.White.copy(
                        alpha = 0.82f
                    ),
                fontSize = 16.sp
            )

            Spacer(
                modifier =
                    Modifier.height(18.dp)
            )

            Text(
                text = name,
                color = Color.White,
                fontSize = 38.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Text(
                text = relationship,
                color =
                    Color.White.copy(
                        alpha = 0.78f
                    ),
                fontSize = 19.sp
            )

            Spacer(
                modifier =
                    Modifier.height(10.dp)
            )

            Text(
                text =
                    "This is what the wearer would see on the glasses.",
                color =
                    Color.White.copy(
                        alpha = 0.65f
                    ),
                textAlign =
                    TextAlign.Center,
                fontSize = 13.sp
            )

            Spacer(
                modifier =
                    Modifier.height(26.dp)
            )

            OutlinedButton(
                onClick = onBack,
                border =
                    BorderStroke(
                        1.dp,
                        Color.White.copy(
                            alpha = 0.5f
                        )
                    )
            ) {
                Text(
                    text =
                        "Back to phone app",
                    color = Color.White
                )
            }
        }
    }
}

