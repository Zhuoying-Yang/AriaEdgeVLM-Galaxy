@Composable
private fun GroceryListDemoScreen(
    items: MutableList<String>,
    memoryItems: MutableList<String>,
    checked: MutableMap<String, Boolean>,
    onBack: () -> Unit,
    onReminder: () -> Unit
) {
    var addingItem by remember {
        mutableStateOf(false)
    }

    var newItem by remember {
        mutableStateOf("")
    }

    var routeStarted by remember {
        mutableStateOf(false)
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(
                rememberScrollState()
            )
    ) {
        SeniorHeader(
            title = "Grocery List",
            onBack = onBack
        )

        Column(
            modifier = Modifier.padding(
                horizontal = 20.dp
            )
        ) {
            Row(
                verticalAlignment =
                    Alignment.CenterVertically
            ) {
                Box(
                    modifier = Modifier
                        .size(48.dp)
                        .clip(
                            RoundedCornerShape(12.dp)
                        )
                        .background(SeniorCard)
                        .border(
                            1.dp,
                            SeniorBorder,
                            RoundedCornerShape(12.dp)
                        ),
                    contentAlignment =
                        Alignment.Center
                ) {
                    Text(
                        text = "✓",
                        fontSize = 22.sp,
                        fontWeight = FontWeight.Bold
                    )
                }

                Spacer(
                    modifier = Modifier.width(14.dp)
                )

                Column {
                    Text(
                        text = "Grocery List",
                        fontSize = 23.sp,
                        fontWeight = FontWeight.Bold
                    )

                    Text(
                        text =
                            "For Elliot's visit on 9/29/26",
                        color = SeniorSecondary,
                        fontSize = 14.sp
                    )
                }
            }

            Spacer(
                modifier = Modifier.height(20.dp)
            )

            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .clip(
                        RoundedCornerShape(18.dp)
                    )
                    .background(
                        Color(0xFFF6F7F9)
                    )
                    .padding(16.dp)
            ) {
                Column {
                    Text(
                        text =
                            "Last edited September 20, 2026 at 4:24 PM",
                        color = SeniorBlue,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold
                    )

                    Spacer(
                        modifier = Modifier.height(12.dp)
                    )

                    items.forEach { item ->
                        GroceryItem(
                            text = item,
                            highlighted =
                                item in memoryItems,
                            checked =
                                checked[item] == true,
                            onClick = {
                                checked[item] =
                                    !(checked[item] == true)
                            }
                        )
                    }
                }
            }

            Spacer(
                modifier = Modifier.height(16.dp)
            )

            if (addingItem) {
                OutlinedTextField(
                    value = newItem,
                    onValueChange = {
                        newItem = it
                    },
                    modifier = Modifier.fillMaxWidth(),
                    label = {
                        Text("New grocery item")
                    },
                    placeholder = {
                        Text(
                            "e.g. Bananas"
                        )
                    },
                    singleLine = true,
                    shape = RoundedCornerShape(16.dp)
                )

                Spacer(
                    modifier = Modifier.height(10.dp)
                )

                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement =
                        Arrangement.spacedBy(10.dp)
                ) {
                    OutlinedButton(
                        onClick = {
                            newItem = ""
                            addingItem = false
                        },
                        modifier = Modifier.weight(1f)
                    ) {
                        Text("Cancel")
                    }

                    Button(
                        onClick = {
                            val item =
                                newItem.trim()

                            if (
                                item.isNotEmpty() &&
                                item !in items
                            ) {
                                items.add(item)
                                checked[item] = false
                            }

                            newItem = ""
                            addingItem = false
                        },
                        modifier = Modifier.weight(1f),
                        colors =
                            ButtonDefaults.buttonColors(
                                containerColor =
                                    SeniorBlue
                            )
                    ) {
                        Text("Add")
                    }
                }

                Spacer(
                    modifier = Modifier.height(16.dp)
                )
            }

            SeniorSecondaryButton(
                text = if (routeStarted) {
                    "Route started ✓"
                } else {
                    "Route me to nearest grocery store"
                },
                onClick = {
                    routeStarted = true
                }
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            SeniorPrimaryButton(
                text = if (addingItem) {
                    "Enter item above"
                } else {
                    "+  Add to shopping list"
                },
                onClick = {
                    addingItem = true
                }
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            SeniorSecondaryButton(
                text = "Preview Memory Reminder",
                onClick = onReminder
            )

            Spacer(
                modifier = Modifier.height(30.dp)
            )
        }
    }
}

@Composable
private fun GroceryItem(
    text: String,
    highlighted: Boolean,
    checked: Boolean,
    onClick: () -> Unit
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp)
            .clip(
                RoundedCornerShape(12.dp)
            )
            .background(
                when {
                    highlighted ->
                        Color(0xFFE7F0FF)

                    checked ->
                        Color(0xFFF1F5F9)

                    else ->
                        Color.Transparent
                }
            )
            .clickable {
                onClick()
            }
            .padding(
                horizontal = 8.dp,
                vertical = 8.dp
            ),
        verticalAlignment =
            Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier
                .size(20.dp)
                .clip(CircleShape)
                .border(
                    width =
                        if (checked || highlighted) {
                            2.dp
                        } else {
                            1.dp
                        },
                    color =
                        if (checked || highlighted) {
                            SeniorBlue
                        } else {
                            Color(0xFFD1D5DB)
                        },
                    shape = CircleShape
                )
                .background(
                    if (checked) {
                        SeniorBlue
                    } else {
                        Color.Transparent
                    }
                ),
            contentAlignment =
                Alignment.Center
        ) {
            if (checked) {
                Text(
                    text = "✓",
                    color = Color.White,
                    fontSize = 12.sp,
                    fontWeight = FontWeight.Bold
                )
            }
        }

        Spacer(
            modifier = Modifier.width(12.dp)
        )

        Text(
            text = text,
            modifier = Modifier.weight(1f),
            fontSize = 14.sp,
            color = when {
                checked ->
                    SeniorSecondary

                highlighted ->
                    SeniorBlue

                else ->
                    Color(0xFF505B6B)
            },
            fontWeight =
                if (highlighted) {
                    FontWeight.Medium
                } else {
                    FontWeight.Normal
                }
        )

        if (highlighted) {
            Text(
                text = "Recently added",
                color = SeniorBlue,
                fontSize = 9.sp
            )
        }
    }
}

