// -----------------------------------------------------------------------------
// Add person with REAL gallery picker
// -----------------------------------------------------------------------------

@Composable
private fun AddPersonScreen(
    onBack: () -> Unit,
    onSave: (
        String,
        String,
        String,
        String?
    ) -> Unit
) {
    var name by remember {
        mutableStateOf("")
    }

    var relationship by remember {
        mutableStateOf("")
    }

    var about by remember {
        mutableStateOf("")
    }

    var photoUri by remember {
        mutableStateOf<String?>(null)
    }

    val photoPicker =
        rememberLauncherForActivityResult(
            contract =
                ActivityResultContracts
                    .GetContent()
        ) {
            uri ->

            if (uri != null) {
                photoUri = uri.toString()
            }
        }

    val canSave =
        name.isNotBlank() &&
        relationship.isNotBlank()

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(
                rememberScrollState()
            )
    ) {
        AppHeader(
            title = "Add Important Person",
            onBack = onBack
        )

        Column(
            modifier = Modifier.padding(
                20.dp
            ),
            horizontalAlignment =
                Alignment.CenterHorizontally
        ) {
            PersonAvatar(
                imageUri = photoUri,
                initials =
                    if (name.isBlank()) {
                        "+"
                    } else {
                        initialsFor(name)
                    },
                size = 100
            )

            Spacer(
                modifier = Modifier.height(10.dp)
            )

            TextButton(
                onClick = {
                    photoPicker.launch(
                        "image/*"
                    )
                }
            ) {
                Text(
                    text = if (
                        photoUri == null
                    ) {
                        "+ Choose photo from gallery"
                    } else {
                        "Change photo"
                    }
                )
            }

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            FieldLabel("NAME")

            OutlinedTextField(
                value = name,
                onValueChange = {
                    name = it
                },
                modifier =
                    Modifier.fillMaxWidth(),
                placeholder = {
                    Text("e.g. Emily")
                },
                singleLine = true,
                shape =
                    RoundedCornerShape(16.dp)
            )

            Spacer(
                modifier = Modifier.height(16.dp)
            )

            FieldLabel("RELATIONSHIP")

            OutlinedTextField(
                value = relationship,
                onValueChange = {
                    relationship = it
                },
                modifier =
                    Modifier.fillMaxWidth(),
                placeholder = {
                    Text("e.g. Your sister")
                },
                singleLine = true,
                shape =
                    RoundedCornerShape(16.dp)
            )

            Spacer(
                modifier = Modifier.height(16.dp)
            )

            FieldLabel("ABOUT")

            OutlinedTextField(
                value = about,
                onValueChange = {
                    about = it
                },
                modifier =
                    Modifier.fillMaxWidth(),
                placeholder = {
                    Text(
                        "e.g. Lives in New York."
                    )
                },
                minLines = 3,
                shape =
                    RoundedCornerShape(16.dp)
            )

            Spacer(
                modifier = Modifier.height(24.dp)
            )

            Button(
                onClick = {
                    if (canSave) {
                        onSave(
                            name.trim(),
                            relationship.trim(),
                            about.trim(),
                            photoUri
                        )
                    }
                },
                enabled = canSave,
                modifier = Modifier
                    .fillMaxWidth()
                    .height(56.dp),
                shape =
                    RoundedCornerShape(16.dp),
                colors =
                    ButtonDefaults
                        .buttonColors(
                            containerColor =
                                AppBlue
                        )
            ) {
                Text(
                    text = "Save Person",
                    fontWeight =
                        FontWeight.Bold
                )
            }

            Spacer(
                modifier = Modifier.height(30.dp)
            )
        }
    }
}


