@Composable
private fun PersonDetailScreen(
    person: PersonProfile,
    groceryItems: List<GroceryEntry>,
    onBack: () -> Unit,
    onAddMemory: () -> Unit,
    onMemoryAction: (MemoryItem) -> Unit,
    onOpenGrocery: () -> Unit,
    onRecognition: () -> Unit
) {
    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(
                rememberScrollState()
            )
    ) {
        AppHeader(
            title = "Person",
            onBack = onBack
        )

        Column(
            modifier = Modifier.padding(
                horizontal = 20.dp
            ),
            horizontalAlignment =
                Alignment.CenterHorizontally
        ) {
            PersonAvatar(
                imageRes = person.imageRes,
                imageUri = person.imageUri,
                initials =
                    initialsFor(person.name),
                size = 100
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            Text(
                text = person.name,
                fontSize = 28.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                text = person.relationship,
                color = AppSecondary,
                fontSize = 15.sp
            )

            Spacer(
                modifier = Modifier.height(26.dp)
            )

            InfoCard(
                label = "ABOUT",
                text = if (
                    person.about.isBlank()
                ) {
                    "No profile information yet."
                } else {
                    person.about
                }
            )

            Spacer(
                modifier = Modifier.height(26.dp)
            )

            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment =
                    Alignment.CenterVertically
            ) {
                Text(
                    text = "Memories",
                    fontSize = 21.sp,
                    fontWeight = FontWeight.Bold,
                    modifier =
                        Modifier.weight(1f)
                )

                Text(
                    text =
                        "${person.memories.size} saved",
                    color = AppSecondary,
                    fontSize = 13.sp
                )
            }

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            if (person.memories.isEmpty()) {
                Surface(
                    modifier =
                        Modifier.fillMaxWidth(),
                    shape =
                        RoundedCornerShape(
                            18.dp
                        ),
                    color = AppCard,
                    border = BorderStroke(
                        1.dp,
                        AppBorder
                    )
                ) {
                    Column(
                        modifier =
                            Modifier.padding(20.dp),
                        horizontalAlignment =
                            Alignment.CenterHorizontally
                    ) {
                        Text(
                            text =
                                "No memories yet",
                            fontWeight =
                                FontWeight.Bold
                        )

                        Spacer(
                            modifier =
                                Modifier.height(5.dp)
                        )

                        Text(
                            text =
                                "Add something useful you would like your glasses to remember about ${person.name}.",
                            textAlign =
                                TextAlign.Center,
                            color =
                                AppSecondary,
                            fontSize = 13.sp,
                            lineHeight = 19.sp
                        )
                    }
                }
            } else {
                person.memories.forEach {
                    memory ->

                    MemoryCard(
                        memory = memory,
                        alreadyInGrocery =
                            memory
                                .grocerySuggestion
                                ?.let {
                                    suggestion ->

                                    groceryItems.any {
                                        it.text.equals(
                                            suggestion,
                                            ignoreCase =
                                                true
                                        )
                                    }
                                } ?: false,
                        onAction = {
                            onMemoryAction(memory)
                        },
                        onOpenGrocery =
                            onOpenGrocery
                    )

                    Spacer(
                        modifier =
                            Modifier.height(12.dp)
                    )
                }
            }

            Spacer(
