// -----------------------------------------------------------------------------
// Data models
// -----------------------------------------------------------------------------

private data class MemoryItem(
    val id: Int,
    val text: String,
    val context: String,
    val grocerySuggestion: String? = null
)

private data class PersonProfile(
    val id: Int,
    val name: String,
    val relationship: String,
    val about: String,
    val imageRes: Int? = null,
    val imageUri: String? = null,
    val memories: List<MemoryItem> = emptyList()
)

private data class GroceryEntry(
    val id: Int,
    val text: String,
    val source: String? = null
)

private enum class SeniorScreen {
    DASHBOARD,
    PEOPLE,
    ADD_PERSON,
    PERSON_DETAIL,
    ADD_MEMORY,
    GROCERY,
    MEMORY_ALERT,
    SAVED_MEMORY,
    RECOGNITION
}


// -----------------------------------------------------------------------------
// Main app
// -----------------------------------------------------------------------------

@Composable
fun SeniorUiApp(
    onOpenSettings: () -> Unit = {}
) {
    var screen by remember {
        mutableStateOf(SeniorScreen.DASHBOARD)
    }

    var selectedPersonId by remember {
        mutableStateOf<Int?>(null)
    }

    var recognitionReturn by remember {
        mutableStateOf(SeniorScreen.PERSON_DETAIL)
    }

    var groceryReturn by remember {
        mutableStateOf(SeniorScreen.DASHBOARD)
    }

    var alertReturn by remember {
        mutableStateOf(SeniorScreen.DASHBOARD)
    }

    var nextPersonId by remember {
        mutableStateOf(4)
    }

    var nextMemoryId by remember {
        mutableStateOf(1000)
    }

    var nextGroceryId by remember {
        mutableStateOf(100)
    }

    val people = remember {
        mutableStateListOf(
            PersonProfile(
                id = 1,
                name = "Jemma",
                relationship = "Your wife",
                about = "Lives with you in Boston.",
                imageRes = R.drawable.jemma,
                memories = listOf(
                    MemoryItem(
                        id = 101,
                        text = "Jemma loved the blue necklace at the store near home.",
                        context = "Shopping together"
                    ),
                    MemoryItem(
                        id = 102,
                        text = "Jemma prefers tea in the evening.",
                        context = "Daily routine"
                    )
                )
            ),
            PersonProfile(
                id = 2,
                name = "Elliot",
                relationship = "Your grandson",
                about = "Visits often and enjoys spending time with you.",
                imageRes = R.drawable.elliot,
                memories = listOf(
                    MemoryItem(
                        id = 201,
                        text = "“Cinnamon raisin bagels are my favorite!”",
                        context = "Last FaceTime call",
                        grocerySuggestion = "Cinnamon raisin bagels"
                    )
                )
            ),
            PersonProfile(
                id = 3,
                name = "Sarah",
                relationship = "Your daughter",
                about = "Works as a nurse at Mass General. Allergic to peanuts.",
                memories = emptyList()
            )
        )
    }

    val groceryItems = remember {
        mutableStateListOf(
            GroceryEntry(
                id = 1,
                text = "Eggs"
            ),
            GroceryEntry(
                id = 2,
                text = "Sourdough bread"
            ),
            GroceryEntry(
                id = 3,
                text = "Strawberries"
            ),
            GroceryEntry(
                id = 4,
                text = "Oat milk"
            ),
            GroceryEntry(
                id = 5,
                text = "Spinach"
            )
        )
    }

    val groceryChecked = remember {
        mutableStateMapOf<Int, Boolean>()
    }

    fun selectedPerson(): PersonProfile? {
        return people.firstOrNull {
            it.id == selectedPersonId
        }
    }

    fun openPerson(id: Int) {
        selectedPersonId = id
        screen = SeniorScreen.PERSON_DETAIL
    }

    fun addGrocery(
        text: String,
        source: String?
    ) {
        val clean = text.trim()

        if (clean.isBlank()) {
            return
        }

        val alreadyExists =
            groceryItems.any {
                it.text.equals(
                    clean,
                    ignoreCase = true
                )
            }

        if (!alreadyExists) {
            groceryItems.add(
                GroceryEntry(
                    id = nextGroceryId++,
                    text = clean,
                    source = source
                )
            )
        }
    }

    BackHandler(
        enabled = screen != SeniorScreen.DASHBOARD
    ) {
        screen = when (screen) {
            SeniorScreen.PEOPLE ->
                SeniorScreen.DASHBOARD

            SeniorScreen.ADD_PERSON ->
                SeniorScreen.PEOPLE

            SeniorScreen.PERSON_DETAIL ->
                SeniorScreen.PEOPLE

            SeniorScreen.ADD_MEMORY ->
                SeniorScreen.PERSON_DETAIL

            SeniorScreen.GROCERY ->
                groceryReturn

            SeniorScreen.MEMORY_ALERT ->
                alertReturn

            SeniorScreen.SAVED_MEMORY ->
                SeniorScreen.MEMORY_ALERT

            SeniorScreen.RECOGNITION ->
                recognitionReturn

            SeniorScreen.DASHBOARD ->
                SeniorScreen.DASHBOARD
        }
    }

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = Color.White
    ) {
        when (screen) {

            SeniorScreen.DASHBOARD -> {
                DashboardScreen(
                    peopleCount = people.size,
                    groceryCount = groceryItems.size,
                    onPeople = {
                        screen = SeniorScreen.PEOPLE
                    },
                    onGrocery = {
                        groceryReturn =
                            SeniorScreen.DASHBOARD

                        screen =
                            SeniorScreen.GROCERY
                    },
                    onAlert = {
                        alertReturn =
                            SeniorScreen.DASHBOARD

                        screen =
                            SeniorScreen.MEMORY_ALERT
                    },
                    onSettings = onOpenSettings
                )
            }

            SeniorScreen.PEOPLE -> {
                PeopleScreen(
                    people = people,
                    onBack = {
                        screen =
                            SeniorScreen.DASHBOARD
                    },
                    onPerson = {
                        openPerson(it)
                    },
                    onAddPerson = {
                        screen =
                            SeniorScreen.ADD_PERSON
                    }
                )
            }

            SeniorScreen.ADD_PERSON -> {
                AddPersonScreen(
                    onBack = {
                        screen =
                            SeniorScreen.PEOPLE
                    },
                    onSave = {
                        name,
                        relationship,
                        about,
                        photoUri ->

                        val newId =
                            nextPersonId++

                        people.add(
                            PersonProfile(
                                id = newId,
                                name = name,
                                relationship =
                                    relationship,
                                about = about,
                                imageUri =
                                    photoUri,
                                memories =
                                    emptyList()
                            )
                        )

                        selectedPersonId =
                            newId

                        screen =
                            SeniorScreen
                                .PERSON_DETAIL
                    }
                )
            }

            SeniorScreen.PERSON_DETAIL -> {
                val person = selectedPerson()

                if (person == null) {
                    screen = SeniorScreen.PEOPLE
                } else {
                    PersonDetailScreen(
                        person = person,
                        groceryItems =
                            groceryItems,
                        onBack = {
                            screen =
                                SeniorScreen.PEOPLE
                        },
                        onAddMemory = {
                            screen =
                                SeniorScreen.ADD_MEMORY
                        },
                        onMemoryAction = {
                            memory ->

                            memory.grocerySuggestion
                                ?.let {
                                    suggestion ->

                                    addGrocery(
                                        text =
                                            suggestion,
                                        source =
                                            "From ${person.name}'s memory"
                                    )
                                }
                        },
                        onOpenGrocery = {
                            groceryReturn =
                                SeniorScreen
                                    .PERSON_DETAIL

                            screen =
                                SeniorScreen.GROCERY
                        },
                        onRecognition = {
                            recognitionReturn =
                                SeniorScreen
                                    .PERSON_DETAIL

                            screen =
                                SeniorScreen
                                    .RECOGNITION
                        }
                    )
                }
            }

            SeniorScreen.ADD_MEMORY -> {
                val person = selectedPerson()

                if (person == null) {
                    screen =
                        SeniorScreen.PEOPLE
                } else {
                    AddMemoryScreen(
                        personName =
                            person.name,
                        onBack = {
                            screen =
                                SeniorScreen
                                    .PERSON_DETAIL
                        },
                        onSave = {
                            text,
                            context ->

                            val index =
                                people.indexOfFirst {
                                    it.id ==
                                        person.id
                                }

                            if (index >= 0) {
                                val current =
                                    people[index]

                                people[index] =
                                    current.copy(
                                        memories =
                                            current.memories +
                                                MemoryItem(
                                                    id =
                                                        nextMemoryId++,
                                                    text =
                                                        text,
                                                    context =
                                                        context
                                                )
                                    )
                            }

                            screen =
                                SeniorScreen
                                    .PERSON_DETAIL
                        }
                    )
                }
            }

            SeniorScreen.GROCERY -> {
                GroceryScreen(
                    items = groceryItems,
                    checked = groceryChecked,
                    onBack = {
                        screen =
                            groceryReturn
                    },
                    onAddItem = {
                        text ->

                        addGrocery(
                            text = text,
                            source = null
                        )
                    }
                )
            }

            SeniorScreen.MEMORY_ALERT -> {
                MemoryAlertScreen(
                    onDismiss = {
                        screen = alertReturn
                    },
                    onViewMemory = {
                        selectedPersonId = 1

                        screen =
                            SeniorScreen
                                .SAVED_MEMORY
                    }
                )
            }

            SeniorScreen.SAVED_MEMORY -> {
                SavedMemoryScreen(
                    onBack = {
                        screen =
                            SeniorScreen
                                .MEMORY_ALERT
                    },
                    onPerson = {
                        selectedPersonId = 1

                        screen =
                            SeniorScreen
                                .PERSON_DETAIL
                    },
                    onHome = {
                        screen =
                            SeniorScreen
                                .DASHBOARD
                    }
                )
            }

            SeniorScreen.RECOGNITION -> {
                val person = selectedPerson()

                if (person == null) {
                    screen =
                        SeniorScreen.PEOPLE
                } else {
                    RecognitionScreen(
                        person = person,
                        onBack = {
                            screen =
                                recognitionReturn
                        }
                    )
                }
            }
        }
    }
}


