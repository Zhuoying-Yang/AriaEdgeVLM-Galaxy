private fun initialsFor(
    name: String
): String {
    val pieces =
        name.trim()
            .split(
                Regex("\\s+")
            )
            .filter {
                it.isNotBlank()
            }

    if (pieces.isEmpty()) {
        return "?"
    }

    return pieces
        .take(2)
        .joinToString("") {
            it.first()
                .uppercaseChar()
                .toString()
        }
}
