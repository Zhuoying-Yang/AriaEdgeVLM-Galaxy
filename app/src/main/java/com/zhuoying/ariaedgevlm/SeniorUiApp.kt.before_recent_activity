        ) {
            if (checked) {
                Text(
                    text = "✓",
                    color = Color.White,
                    fontSize = 12.sp,
                    fontWeight = FontWeight.Bold
                )
            }
        }

        Spacer(
            modifier = Modifier.width(12.dp)
        )

        Column(
            modifier = Modifier.weight(1f)
        ) {
            Text(
                text = entry.text,
                fontSize = 15.sp,
                fontWeight =
                    if (
                        entry.source != null
                    ) {
                        FontWeight.SemiBold
                    } else {
                        FontWeight.Normal
                    },
                color =
                    if (checked) {
                        AppSecondary
                    } else {
                        Color(0xFF29313D)
                    }
            )

            if (entry.source != null) {
                Spacer(
                    modifier =
                        Modifier.height(3.dp)
                )

                Text(
                    text = entry.source,
                    color = AppBlue,
                    fontSize = 11.sp
                )
            }
        }
    }
}


