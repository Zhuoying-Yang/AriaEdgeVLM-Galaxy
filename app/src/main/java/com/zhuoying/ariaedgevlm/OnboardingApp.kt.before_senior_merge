@Composable
fun OnboardingApp(
    status: String,
    answer: String,
    onAskAI: () -> Unit
) {
    val context = LocalContext.current

    val prefs = remember {
        context.getSharedPreferences(
            "aria_edge_vlm_prefs",
            0
        )
    }

    var step by rememberSaveable {
        mutableStateOf(
            if (prefs.getBoolean("setup_complete", false)) {
                8
            } else {
                0
            }
        )
    }
    var userType by rememberSaveable { mutableStateOf("self") }
    var textSize by rememberSaveable {
        mutableStateOf(
            prefs.getString("text_size", "M") ?: "M"
        )
    }

    var displayOpacity by rememberSaveable {
        mutableStateOf(
            prefs.getString("display_opacity", "Medium") ?: "Medium"
        )
    }

    var addedPersonName by rememberSaveable {
        mutableStateOf("")
    }

    var addedPersonRelationship by rememberSaveable {
        mutableStateOf("")
    }

    var addedPersonNote by rememberSaveable {
        mutableStateOf("")
    }

    val baseDensity = LocalDensity.current

    val appFontScale = when (textSize) {
        "XS" -> 0.82f
        "S" -> 0.92f
        "M" -> 1.00f
        "L" -> 1.12f
        "XL" -> 1.25f
        else -> 1.00f
    }

    CompositionLocalProvider(
        LocalDensity provides Density(
            density = baseDensity.density,
            fontScale = baseDensity.fontScale * appFontScale
        )
    ) {
        Surface(
            modifier = Modifier.fillMaxSize(),
            color = Color.White
        ) {
            when (step) {
            0 -> WelcomeScreen { step = 1 }

            1 -> UserTypeScreen(
                selected = userType,
                onSelected = { userType = it },
                onContinue = { step = 2 }
            )

            2 -> BluetoothScreen { step = 3 }

            3 -> PowerOnScreen { step = 4 }

            4 -> ConnectingScreen { step = 5 }

            5 -> ConnectedScreen { step = 6 }

            6 -> TextSizeScreen(
                selected = textSize,
                onSelected = {
                    textSize = it
                    prefs.edit()
                        .putString("text_size", it)
                        .apply()
                },
                onContinue = { step = 7 }
            )

            7 -> SetupCompleteScreen(
                textSize = textSize,
                onStart = {
                    prefs.edit()
                        .putBoolean("setup_complete", true)
                        .apply()

                    step = 8
                }
            )

            8 -> HomeScreen(
                status = status,
                answer = answer,
                onAskAI = onAskAI,
                onMemories = { step = 9 },
                onSettings = { step = 10 },
                onSafetyAlert = { step = 13 },
                onMemoryAlert = { step = 14 }
            )

            9 -> MemoriesScreen(
                onBack = { step = 8 },
                onPerson = { step = 11 },
                onAddPerson = { step = 12 },
                addedPersonName = addedPersonName,
                addedPersonRelationship = addedPersonRelationship
            )

            11 -> PersonDetailScreen(
                onBack = { step = 9 }
            )

            12 -> AddPersonScreen(
                onBack = { step = 9 },
                onSave = { name, relationship, note ->
                    addedPersonName = name
                    addedPersonRelationship = relationship
                    addedPersonNote = note
                    step = 9
                }
            )

            13 -> SafetyAlertScreen(
                onDismiss = { step = 8 }
            )

            14 -> MemoryAlertScreen(
                onDismiss = { step = 8 }
            )

            10 -> SettingsScreen(
                selectedTextSize = textSize,
                selectedOpacity = displayOpacity,

                onTextSizeChanged = {
                    textSize = it
                    prefs.edit()
                        .putString("text_size", it)
                        .apply()
                },

                onOpacityChanged = {
                    displayOpacity = it
                    prefs.edit()
                        .putString("display_opacity", it)
                        .apply()
                },

                onBack = { step = 8 },

                onReset = {
                    prefs.edit()
                        .clear()
                        .apply()

                    textSize = "M"
                    displayOpacity = "Medium"
                    step = 0
                }
            )
            }
        }
    }
}

