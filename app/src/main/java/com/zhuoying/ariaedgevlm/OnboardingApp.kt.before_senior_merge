            Surface(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(82.dp),
                shape = RoundedCornerShape(12.dp),
                color = Color.Black
            ) {
                Box(
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        text = "Display preview",
                        fontSize = 17.sp,
                        fontWeight = FontWeight.SemiBold,
                        color = Color.White.copy(
                            alpha = when (selectedOpacity) {
                                "Low" -> 0.40f
                                "Medium" -> 0.70f
                                "High" -> 1.00f
                                else -> 0.70f
                            }
                        )
                    )
                }
            }

            Spacer(modifier = Modifier.height(28.dp))

            Surface(
                modifier = Modifier
                    .fillMaxWidth()
                    .clickable {
                        onReset()
                    },
                shape = RoundedCornerShape(12.dp),
