@Composable
private fun AddPersonDemoScreen(
    onBack: () -> Unit,
    onSave: () -> Unit
) {
    var filled by remember {
        mutableStateOf(false)
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(
                rememberScrollState()
            )
    ) {
        SeniorHeader(
            title = "Add Person",
            onBack = onBack
        )

        Column(
            modifier = Modifier.padding(20.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            if (filled) {
                SeniorAvatar(
                    imageRes = R.drawable.jemma,
                    size = 94
                )
            } else {
                Box(
                    modifier = Modifier
                        .size(94.dp)
                        .clip(CircleShape)
                        .background(SeniorLightBlue)
                        .border(
                            2.dp,
                            SeniorBlue,
                            CircleShape
                        )
                        .clickable {
                            filled = true
                        },
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        text = "+",
                        color = SeniorBlue,
                        fontSize = 38.sp
                    )
                }
            }

            Spacer(
                modifier = Modifier.height(18.dp)
            )

            DemoField(
                label = "FULL NAME",
                value = if (filled) {
                    "Jemma"
                } else {
                    "Tap to fill demo information"
                },
                onClick = {
                    filled = true
                }
            )

            DemoField(
                label = "RELATIONSHIP",
                value = if (filled) {
                    "Wife"
                } else {
                    "Relationship"
                },
                onClick = {
                    filled = true
                }
            )

            DemoField(
                label = "WHAT YOUR GLASSES WILL SAY",
                value = if (filled) {
                    "This is Jemma, your wife."
                } else {
                    "Recognition message"
                },
                onClick = {
                    filled = true
                }
            )

            DemoField(
                label = "MEMORY NOTES",
                value = if (filled) {
                    "Lives with you in Boston."
                } else {
                    "Important details"
                },
                onClick = {
                    filled = true
                }
            )

            Spacer(
                modifier = Modifier.height(16.dp)
            )

            SeniorPrimaryButton(
                text = if (filled) {
                    "Save Person"
                } else {
                    "Fill Demo Information"
                },
                onClick = {
                    if (filled) {
                        onSave()
                    } else {
                        filled = true
                    }
                }
            )
        }
    }
}

@Composable
private fun DemoField(
    label: String,
    value: String,
    onClick: (() -> Unit)? = null
) {
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(bottom = 14.dp)
    ) {
        Text(
            text = label,
            color = SeniorBlue,
            fontSize = 11.sp,
            fontWeight = FontWeight.Bold
        )

        Spacer(
            modifier = Modifier.height(6.dp)
        )

        Box(
            modifier = Modifier
                .fillMaxWidth()
                .clip(RoundedCornerShape(15.dp))
                .background(SeniorCard)
                .border(
                    1.dp,
                    SeniorBorder,
                    RoundedCornerShape(15.dp)
                )
                .then(
                    if (onClick != null) {
                        Modifier.clickable {
                            onClick()
                        }
                    } else {
                        Modifier
                    }
                )
                .padding(16.dp)
        ) {
            Text(
                text = value,
                fontSize = 15.sp
            )
        }
    }
}

