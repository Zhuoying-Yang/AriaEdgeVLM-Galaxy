private enum class SeniorScreen {
    HOME,
    ADD_PERSON,
    JEMMA_DETAIL,
    SARAH_DETAIL,
    FAMILY_MEMORY,
    GROCERY_LIST,
    MEMORY_ALERT,
    SAVED_MEMORY,
    RECOGNITION
}

@Composable
fun SeniorUiApp() {
    var screen by remember {
        mutableStateOf(SeniorScreen.HOME)
    }

    var recognitionName by remember {
        mutableStateOf("Jemma")
    }

    var recognitionRelationship by remember {
        mutableStateOf("Your wife")
    }

    fun go(destination: SeniorScreen) {
        screen = destination
    }

    BackHandler(
        enabled = screen != SeniorScreen.HOME
    ) {
        screen = when (screen) {
            SeniorScreen.ADD_PERSON,
            SeniorScreen.JEMMA_DETAIL,
            SeniorScreen.SARAH_DETAIL,
            SeniorScreen.FAMILY_MEMORY,
            SeniorScreen.MEMORY_ALERT ->
                SeniorScreen.HOME

            SeniorScreen.GROCERY_LIST ->
                SeniorScreen.FAMILY_MEMORY

            SeniorScreen.SAVED_MEMORY ->
                SeniorScreen.MEMORY_ALERT

            SeniorScreen.RECOGNITION ->
                SeniorScreen.HOME

            SeniorScreen.HOME ->
                SeniorScreen.HOME
        }
    }

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = Color.White
    ) {
        when (screen) {
            SeniorScreen.HOME -> {
                ImportantPeopleScreen(
                    onAdd = {
                        go(SeniorScreen.ADD_PERSON)
                    },
                    onJemma = {
                        go(SeniorScreen.JEMMA_DETAIL)
                    },
                    onSarah = {
                        go(SeniorScreen.SARAH_DETAIL)
                    },
                    onElliot = {
                        go(SeniorScreen.FAMILY_MEMORY)
                    },
                    onMemoryAlert = {
                        go(SeniorScreen.MEMORY_ALERT)
                    }
                )
            }

            SeniorScreen.ADD_PERSON -> {
                AddPersonDemoScreen(
                    onBack = {
                        go(SeniorScreen.HOME)
                    },
                    onSave = {
                        go(SeniorScreen.JEMMA_DETAIL)
                    }
                )
            }

            SeniorScreen.JEMMA_DETAIL -> {
                SeniorPersonDetailScreen(
                    name = "Jemma",
                    relationship = "Your wife",
                    note = "Lives with you in Boston.",
                    imageRes = R.drawable.jemma,
                    initials = null,
                    onBack = {
                        go(SeniorScreen.HOME)
                    },
                    onRecognition = {
                        recognitionName = "Jemma"
                        recognitionRelationship = "Your wife"
                        go(SeniorScreen.RECOGNITION)
                    }
                )
            }

            SeniorScreen.SARAH_DETAIL -> {
                SeniorPersonDetailScreen(
                    name = "Sarah",
                    relationship = "Your daughter",
                    note = "Works as a nurse at Mass General.",
                    imageRes = null,
                    initials = "SA",
                    onBack = {
                        go(SeniorScreen.HOME)
                    },
                    onRecognition = {
                        recognitionName = "Sarah"
                        recognitionRelationship = "Your daughter"
                        go(SeniorScreen.RECOGNITION)
                    }
                )
            }

            SeniorScreen.FAMILY_MEMORY -> {
                FamilyMemoryDemoScreen(
                    onBack = {
                        go(SeniorScreen.HOME)
                    },
                    onShoppingList = {
                        go(SeniorScreen.GROCERY_LIST)
                    }
                )
            }

            SeniorScreen.GROCERY_LIST -> {
                GroceryListDemoScreen(
                    onBack = {
                        go(SeniorScreen.FAMILY_MEMORY)
                    },
                    onReminder = {
                        go(SeniorScreen.MEMORY_ALERT)
                    }
                )
            }

            SeniorScreen.MEMORY_ALERT -> {
                MemoryAlertDemoScreen(
                    onDismiss = {
                        go(SeniorScreen.HOME)
                    },
                    onView = {
                        go(SeniorScreen.SAVED_MEMORY)
                    }
                )
            }

            SeniorScreen.SAVED_MEMORY -> {
                SavedMemoryDemoScreen(
                    onBack = {
                        go(SeniorScreen.MEMORY_ALERT)
                    },
                    onHome = {
                        go(SeniorScreen.HOME)
                    }
                )
            }

            SeniorScreen.RECOGNITION -> {
                RecognitionDemoScreen(
                    name = recognitionName,
                    relationship = recognitionRelationship,
                    onBack = {
                        go(SeniorScreen.HOME)
                    }
                )
            }
        }
    }
}

@Composable
private fun SeniorHeader(
    title: String,
    onBack: (() -> Unit)? = null
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(
                horizontal = 20.dp,
                vertical = 18.dp
            ),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier.width(48.dp)
        ) {
            if (onBack != null) {
                Text(
                    text = "‹",
                    fontSize = 38.sp,
                    modifier = Modifier.clickable {
                        onBack()
                    }
                )
            }
        }

        Text(
            text = title,
            fontSize = 19.sp,
            fontWeight = FontWeight.Bold,
            textAlign = TextAlign.Center,
            modifier = Modifier.weight(1f)
        )

        Spacer(
            modifier = Modifier.width(48.dp)
        )
    }
}

